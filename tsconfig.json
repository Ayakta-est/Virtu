{
  "compilerOptions": {
    "target": "ES6",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "module": "ESNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "noImplicitAny": false
  },
  "include": ["src", "src/vite-env.d.ts"],
  "exclude": ["node_modules"]
}
